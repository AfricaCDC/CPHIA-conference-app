# The app is built for /app/ on the same domain as the Laravel API, so no URL is needed in production.
# Only set this to point a local build at another API (default: /api/mobile/v1 on the same origin).
# VITE_API_BASE_URL=http://localhost:8080/api/mobile/v1
# Conference the app signs in to (falls back to the server's current conference after sign-in).
VITE_EVENT_SLUG=cphia-2026
# Official PWA / native key, sent as X-Mobile-App-Key on every API call.
# Issue in Admin → SSO & Auth → API keys → Mobile apps, then paste the plain
# value here (and as Laravel MOBILE_APP_API_KEY if you keep the env fallback).
# Required when any mobile key is active on the server. Leave empty for local
# Laravel with no mobile keys configured.
# VITE_MOBILE_APP_API_KEY=
